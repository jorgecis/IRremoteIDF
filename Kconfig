menu "IRremote (infrared send/receive)"

config IRREMOTE_KCONFIG_PRESENT
    bool
    default y
    help
        Internal marker so the library knows the Kconfig options
        were applied. Not user selectable.

config IRREMOTE_TX_HW_CARRIER
    bool "Generate the transmit carrier in hardware (LEDC)"
    default n
    help
        Use an LEDC channel to produce the 30-60 kHz carrier instead of
        toggling the GPIO from the CPU. This frees the CPU during a
        transmission and gives a cleaner duty cycle, at the cost of one
        LEDC channel and timer per IRsend instance.

config IRREMOTE_DEBUG
    bool "Print library debug output"
    default n
    help
        Enables the library's DPRINT/DPRINTLN tracing on stdout.

